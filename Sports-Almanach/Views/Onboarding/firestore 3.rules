rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Profile Collection
    // Each user can only access their own profile
    match /Profile/{userID} {
      allow read, write: if request.auth != null && request.auth.uid == userID;
      
      // User's events subcollection
      match /events/{eventID} {
        allow read, write: if request.auth != null && request.auth.uid == userID;
      }
    }
    
    // BetSlips Collection
    // Users can only access their own bet slips
    match /BetSlips/{slipID} {
      // User can read their own slips
      allow read: if request.auth != null && 
                     request.auth.uid == resource.data.userID;
      
      // User can write (create + update) their own slips
      // WICHTIG: "write" statt nur "create", weil Transactions setData() verwenden!
      allow write: if request.auth != null && 
                      request.auth.uid == request.resource.data.userID;
      
      // Bets subcollection within a slip
      // Users can read/write bets in their own slips
      match /bets/{betID} {
        allow read, write: if request.auth != null && 
                              request.auth.uid == get(/databases/$(database)/documents/BetSlips/$(slipID)).data.userID;
      }
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
