rules_version = '2';

// Firestore security rules for Sports-Almanach.
//
// Collection / field names match the app exactly (case-sensitive):
//   Profile / events  ·  BetSlips / bets  ·  slip owner field "userID".
//
// Notes:
//  * Profile READ is allowed for any signed-in user because the ranking page
//    (UserViewModel.loadAllProfiles) lists every profile. WRITE stays owner-only.
//  * The /bets sub-collection is written together with its parent slip inside a
//    single transaction; get()/exists() can't see the not-yet-committed parent,
//    so we also allow the write while the parent does not exist yet.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userID) {
      return isAuthenticated() && request.auth.uid == userID;
    }

    // Profile/{userID}
    match /Profile/{userID} {
      allow read:  if isAuthenticated();      // ranking lists all profiles
      allow write: if isOwner(userID);        // but only you change your own

      match /events/{eventID} {
        allow read, write: if isOwner(userID);
      }
    }

    // BetSlips/{slipID}
    match /BetSlips/{slipID} {
      allow read:   if isAuthenticated() && resource.data.userID == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userID == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userID == request.auth.uid;

      match /bets/{betID} {
        allow read, write: if isAuthenticated() && (
          !exists(/databases/$(database)/documents/BetSlips/$(slipID))
          || get(/databases/$(database)/documents/BetSlips/$(slipID)).data.userID == request.auth.uid
        );
      }
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
